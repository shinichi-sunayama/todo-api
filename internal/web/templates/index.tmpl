<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>TODOアプリ</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-5">
  <h1 class="mb-4">TODO一覧</h1>

  {{ if .flash }}
    <div class="alert alert-info alert-dismissible fade show" role="alert">
      {{ .flash }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
    </div>
  {{ end }}

  <!-- 登録フォーム -->
  <form action="/api/todos" method="POST" class="row g-3 mb-4">
    <div class="col-auto">
      <input type="text" name="title" class="form-control" placeholder="新しいTODOを入力" maxlength="100" required>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary">追加</button>
    </div>
  </form>

  <!-- TODOリスト -->
  <table class="table table-hover table-bordered bg-white">
    <thead>
      <tr>
        <th style="width: 5%">完了</th>
        <th>タイトル</th>
        <th style="width: 20%">操作</th>
      </tr>
    </thead>
    <tbody>
      {{ range .todos }}
        <tr>
          <td class="text-center">
            <form action="/toggle/{{ .ID }}" method="POST">
              <input type="checkbox" onchange="this.form.submit()" {{ if .Done }}checked{{ end }}>
            </form>
          </td>
          <td class="{{ if .Done }}text-decoration-line-through text-muted{{ end }}">
            {{ .Title }}
          </td>
          <td>
            <!-- 編集ボタン（モーダル） -->
            <button class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#editModal{{ .ID }}">編集</button>

            <!-- 削除ボタン -->
            <form action="/delete/{{ .ID }}" method="POST" class="d-inline">
              <button class="btn btn-sm btn-danger" onclick="return confirm('削除してもよろしいですか？')">削除</button>
            </form>
          </td>
        </tr>

        <!-- 編集モーダル -->
        <div class="modal fade" id="editModal{{ .ID }}" tabindex="-1" aria-labelledby="editModalLabel{{ .ID }}" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/update/{{ .ID }}" method="POST">
                <div class="modal-header">
                  <h5 class="modal-title" id="editModalLabel{{ .ID }}">TODO編集</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                </div>
                <div class="modal-body">
                  <input type="text" name="title" class="form-control" value="{{ .Title }}" maxlength="100" required>
                </div>
                <div class="modal-footer">
                  <button type="submit" class="btn btn-primary">更新</button>
                </div>
              </form>
            </div>
          </div>
        </div>

      {{ end }}
    </tbody>
  </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
